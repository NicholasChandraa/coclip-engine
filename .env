# App
PROJECT_NAME="CoClip Engine"
API_V1_STR="/api/v1"

# Whisper Settings
WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
WHISPER_DEVICE=cuda

WHISPER_COMPUTE_TYPE=float16
# WHISPER_COMPUTE_TYPE=int8

# WhisperX Settings
ENABLE_DIARIZATION=true

# Gemini
GEMINI_API_KEY=AIzaSyB15Why-sG1Uu_zyp6Qcw6cVRcXHu0M7CA

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Storage
TEMP_DIR=../storage/temp

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/model_clip

# Video Output Format (tiktok, reels, shorts, square, landscape)
OUTPUT_FORMAT=tiktok

# Subtitle Settings
SUBTITLE_UPPERCASE=true  # Convert all subtitle text to UPPERCASE (clipper/shorts style)

# Smart Crop (Active Speaker Detection)
ENABLE_SMART_CROP=true
CROP_MODE=smart

# Hugging Face Token
HF_TOKEN=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